#!/usr/bin/env node
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { DIALECTS, resolveDialect } from './src/dialect-registry.js';
import { fileURLToPath as f2 } from 'url';
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

let args = process.argv.slice(2);
let code = args[0] &&!args[0].startsWith('-')? args[0] : null;
if (code && code.endsWith('.bayda')) {
  code = resolveDialect(path.basename(code));
}
const pick = (c) => {
  const resolved = resolveDialect(c);
  return DIALECTS[resolved] || null;
};

if (!code || args.includes('--help') || args.includes('-h')) {
  console.error('usage: bayda <file> [dialect code] | bayda init [--dialect code]');
  process.exit(1);
}

if (code === 'init') {
  const dArgIndex = args.indexOf('--dialect');
  const dCode = dArgIndex!== -1? args[dArgIndex+1] : 'tn-latn';
  const d = pick(dCode) || pick('tn-latn');
  console.log(`init ${d.id}`);
  process.exit(0);
}

const file = args.find(a => a.endsWith('.bayda'));
if (!file) {
  console.error('usage: bayda <file>');
  process.exit(1);
}
const dialect = pick(code || path.basename(file).split('.')[1] || 'tn-latn');
if (!dialect) {
  console.error(`unknown dialect ${code}`);
  process.exit(1);
}
console.log(`running with ${dialect.id}`);
