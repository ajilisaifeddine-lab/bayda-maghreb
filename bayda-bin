#!/usr/bin/env node

import { loadDialect } from "./dist/core/loader.js";
import fs from "fs";
import path from "path";

const args = process.argv.slice(2);
const code = args[0] && !args[0].startsWith("--") ? args[0] : null;

if (!code || args.includes("--help") || args.includes("-h")) {
  console.error("usage: bayda <file> [--dialect code]");
  process.exit(1);
}

if (code === "init") {
  console.log("init command not implemented yet.");
  process.exit(0);
}

const file = args.find((a) => a.endsWith(".bayda"));
if (!file) {
  console.error("usage: bayda <file>");
  process.exit(1);
}

const dialectArgIndex = args.indexOf("--dialect");
const dialectCode = dialectArgIndex !== -1 ? args[dialectArgIndex + 1] : "tn-latn";

try {
  const dialect = loadDialect(dialectCode, { consent: true });
  if (!dialect) {
    console.error(`Unknown dialect: ${dialectCode}`);
    process.exit(1);
  }
  
  console.log(`running with ${dialect.id}`);
  
} catch (e) {
  console.error(`Error: ${e.message}`);
  process.exit(1);
}
