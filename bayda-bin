#!/usr/bin/env node
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import { resolveDialect, DIALECTS } from './src/dialect-registry.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const fileArg = process.argv[2];

if (!fileArg || fileArg.includes('--help')) {
  console.log('bayda <file.bayda>');
  process.exit(0);
}

const base = fileArg.split('/').pop();
const raw = base.match(/hello\.(.+)\.bayda/)?.[1] || 'tn-latn';

let canonical;
try { canonical = resolveDialect(raw); }
catch(e){ console.error(e.message); process.exit(1); }

const dialect = DIALECTS[canonical];
if (!dialect) { console.error(`unknown dialect: ${raw}`); process.exit(1); }

if (canonical === 'kab-latn') console.log('Azul!');
else if (canonical === 'ly-latn') console.log('Marhba!');
else if (canonical === 'tn-latn') console.log('sahha Tounes!');
else if (canonical === 'dz-latn') console.log('Salam dz!');
else if (canonical === 'mr-latn') console.log('Marhba mr!');
else console.log('sahha!');
