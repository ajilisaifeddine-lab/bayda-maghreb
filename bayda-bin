#!/usr/bin/env node
/**
 * bayda — واجهة سطر الأوامر.
 * يقرأ ملف .bayda، يحمّل اللهجة، ويمرّر الكل عبر translate().
 *
 * الاستخدام:
 *   bayda hello.tn-latn.bayda                 # يطبع JavaScript
 *   bayda hello.tn-latn.bayda --py            # يطبع Python
 *   bayda hello.tn-latn.bayda --dialect tn-latn
 *   bayda hello.tn-latn.bayda --run           # ينفّذ JavaScript الناتج
 *   bayda hello.tn-latn.bayda -o out.js       # يحفظ الناتج في ملف
 */
import fs from "fs";
import path from "path";
import { spawnSync } from "child_process";
import { translateDialect } from "./dist/core/translate-node.js";

const args = process.argv.slice(2);

if (!args.length || args.includes("--help") || args.includes("-h")) {
  console.error("usage: bayda <file.bayda> [--dialect code] [--py] [--run] [-o out]");
  process.exit(1);
}

const file = args.find((a) => a.endsWith(".bayda"));
if (!file) {
  console.error("usage: bayda <file.bayda> [--dialect code] [--py] [--run]");
  process.exit(1);
}

const dIdx = args.indexOf("--dialect");
const dialect =
  dIdx !== -1 && args[dIdx + 1]
    ? args[dIdx + 1]
    : path.basename(file).split(".")[1] || "tn-latn";

const target = args.includes("--py") || args.includes("--python") ? "py" : "js";
const oIdx = args.indexOf("-o");
const outFile = oIdx !== -1 ? args[oIdx + 1] : null;
const shouldRun = args.includes("--run");

try {
  const src = fs.readFileSync(file, "utf8");
  const result = translateDialect(src, { dialect, target, consent: true });

  if (outFile) {
    fs.writeFileSync(outFile, result.code + "\n", "utf8");
    console.error(`✅ ${dialect} → ${target} : ${outFile}`);
  } else {
    console.log(result.code);
  }

  if (shouldRun) {
    if (target === "js") {
      const tmp = path.join(process.cwd(), ".bayda-run.mjs");
      fs.writeFileSync(tmp, result.code + "\n", "utf8");
      const r = spawnSync(process.execPath, [tmp], { stdio: "inherit" });
      fs.rmSync(tmp, { force: true });
      process.exit(r.status ?? 0);
    } else {
      const tmp = path.join(process.cwd(), ".bayda-run.py");
      fs.writeFileSync(tmp, result.code + "\n", "utf8");
      const r = spawnSync("python3", [tmp], { stdio: "inherit" });
      fs.rmSync(tmp, { force: true });
      process.exit(r.status ?? 0);
    }
  }
} catch (e) {
  console.error(`Error: ${e.message}`);
  process.exit(1);
}
