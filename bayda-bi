#!/usr/bin/env node

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import { resolveDialect, DIALECTS } from './src/dialect-registry.js';

// التعامل مع المسارات في ESM
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const args = process.argv.slice(2);
const code = args[0] && !args[0].startsWith('--') ? args[0] : null;

// دالة مساعدة لاختيار اللهجة
const pick = (c) => {
  const r = resolveDialect(c);
  return DIALECTS[r] || null;
};

// 1. التحقق من وجود الملف أو أمر المساعدة
if (!code || args.includes('--help') || args.includes('-h')) {
  console.error('usage: bayda <file> [dialect code] | bayda init [--dialect code]');
  process.exit(1);
}

// 2. أمر التهيئة (init)
if (code === 'init') {
  const dArgIndex = args.indexOf('--dialect');
  const dCode = dArgIndex !== -1 ? args[dArgIndex + 1] : 'tn-latn';
  const d = pick(dCode) || pick('tn-latn');
  console.log(`init ${d.id}`);
  process.exit(0);
}

// 3. قراءة الملف وتحديد اللهجة
const file = args.find(a => a.endsWith('.bayda'));
if (!file) {
  console.error('usage: bayda <file>');
  process.exit(1);
}

// تحديد اللهجة من اسم الملف أو من الأمر
const dialectCode = args.find(a => !a.endsWith('.bayda') && a !== code) || path.basename(file).split('.')[1] || 'tn-latn';
const dialect = pick(dialectCode);

if (!dialect) {
  console.error(`unknown dialect ${dialectCode}`);
  process.exit(1);
}

console.log(`running with ${dialect.id}`);
